{
  "name": "savannahdb-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace root for SavannahDB. The published package is @nigelbasa/savannahdb (under server/).",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build:native": "scripts\\build-native.cmd",
    "build:ts": "npm run build --workspace @nigelbasa/savannahdb",
    "build": "npm run build:native && npm run build:ts",
    "prebuild": "node scripts/prebuild.mjs",
    "compare:driver": "node scripts/compare-driver.mjs",
    "generate:mongodb-target": "node scripts/generate-mongodb-target.mjs",
    "smoke:canopy-restart": "node scripts/smoke-canopy-restart.mjs",
    "smoke:driver": "node scripts/smoke-driver.mjs",
    "smoke:engine": "node scripts/smoke-engine.mjs",
    "bench": "node scripts/audit/run.mjs --skip-mongo && node scripts/audit/render.mjs",
    "dev": "npm run dev --workspace @nigelbasa/savannahdb",
    "start": "npm start --workspace @nigelbasa/savannahdb"
  },
  "dependencies": {
    "node-addon-api": "^8.3.0"
  },
  "devDependencies": {
    "better-sqlite3": "^11.7.0",
    "cmake-js": "^7.3.0"
  }
}
