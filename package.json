{
  "name": "savannahdb",
  "version": "0.1.0",
  "private": true,
  "description": "MongoDB wire-compatible document database",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build:native": "scripts\\build-native.cmd",
    "build:ts": "npm run build --workspace server",
